{
  "expo": {
    "name": "Tare Capture",
    "slug": "tare-capture",
    "version": "0.1.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tare.capture",
      "infoPlist": {
        "NSCameraUsageDescription": "Record object images and ARKit camera poses for 3D reconstruction.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/withPodDeploymentTarget"
    ],
    "extra": {
      "eas": {
        "projectId": "0101e44e-39da-4dbe-ab87-80eb00587ff9"
      }
    },
    "owner": "misoverfitting"
  }
}
